dbrp "datain"."autogen"

var data0 = batch
        |query('SELECT * FROM "datain"."autogen"."wind-turbine-data"')
                .period(10s)
                .every(10s)
        @windturbine_batch_anomaly_detector()
data0
        |influxDBOut()
                .buffer(0)
                .database('datain')
                .measurement('wind-turbine-anomaly-data')
                .retentionPolicy('autogen')
data0
        |alert()
                .crit(lambda: "anomaly_status" > 0)
                .message('Anomaly detected for wind speed: {{ index .Fields "wind_speed" }} Grid Active Power: {{ index .Fields "grid_active_power" }} Anomaly Status: {{ index .Fields "anomaly_status" }} ')
                .noRecoveries()
                .mqtt('my_mqtt_broker')
                .topic('alerts/wind_turbine')
                .qos(1)
